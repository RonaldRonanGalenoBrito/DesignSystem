@inherits ExampleBase
@attribute [ComponentExample(typeof(Pagination))]

<div class="options-panel">
    <label>Tamanho<select class="form-select form-select-sm mt-1" @bind="size">@foreach (var value in Enum.GetValues<PaginationSize>()) { <option value="@value">@value</option> }</select></label>
    <label class="form-check"><input type="checkbox" class="form-check-input" @bind="disabled" /> Desabilitada</label>
</div>
<CodeExample Code="@Code">
    <Pagination PageCount="20" @bind-CurrentPage="currentPage" Size="@size" Disabled="@disabled" />
    <p class="small text-body-secondary mt-3 mb-0" role="status">Página atual: @currentPage</p>
</CodeExample>

@code {
    private int currentPage = 1;
    private PaginationSize size = PaginationSize.Medium;
    private bool disabled;
    private string Code => $"<Pagination PageCount=\"20\" @bind-CurrentPage=\"currentPage\"\n            Size=\"PaginationSize.{size}\" Disabled=\"{Bool(disabled)}\" />\n\n@code {{\n    private int currentPage = {currentPage};\n}}";
}
