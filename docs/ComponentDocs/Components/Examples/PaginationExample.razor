@inherits ExampleBase
@attribute [ComponentExample(typeof(Pagination))]
@implements IDisposable

<div class="options-panel">
    <label>Tamanho<select class="form-select form-select-sm mt-1" @bind="size">@foreach (var value in Enum.GetValues<PaginationSize>()) { <option value="@value">@value</option> }</select></label>
    <label class="form-check"><input type="checkbox" class="form-check-input" @bind="pagination.IsLoading" /> Carregando</label>
</div>
<CodeExample Code="@Code">
    <Pagination State="@pagination" Size="@size" />
    <p class="small text-body-secondary mt-3 mb-0" role="status">Página atual: @pagination.CurrentPage</p>
</CodeExample>

@code {
    private readonly PaginationState<string> pagination = new(pageSize: 10);
    private PaginationSize size = PaginationSize.Medium;

    protected override void OnInitialized()
    {
        pagination.SetItems(Enumerable.Range(1, 300).Select(number => $"Registro {number}"));
        pagination.Changed += HandlePaginationChanged;
    }

    private void HandlePaginationChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => pagination.Changed -= HandlePaginationChanged;

    private string Code => $"<Pagination State=\"@pagination\" Size=\"PaginationSize.{size}\" />\n\n@code {{\n    private readonly PaginationState<string> pagination = new(pageSize: 10);\n\n    protected override void OnInitialized()\n    {{\n        pagination.SetItems(Enumerable.Range(1, 300).Select(number => $\"Registro {{number}}\"));\n    }}\n}}";
}
