@inherits ExampleBase
@attribute [ComponentExample(typeof(Pagination))]
@implements IDisposable

<div class="options-panel">
    <label>Tema
        <select class="form-control form-control-sm mt-1" @bind="theme">
            <option value="">Padrão</option>
            @foreach (var value in Enum.GetValues<ThemeColor>()) { <option value="@value">@value</option> }
        </select>
    </label>
    <label>Tamanho<select class="form-control form-control-sm mt-1" @bind="size">@foreach (var value in Enum.GetValues<PaginationSize>()) { <option value="@value">@value</option> }</select></label>
    <label class="d-flex align-items-center gap-2"><input type="checkbox" class="check" @bind="pagination.IsLoading" /> Carregando</label>
</div>
<CodeExample Code="@Code">
    <Pagination State="@pagination" Size="@size" Theme="@theme" />
    <p class="small fg-2 mt-4 mb-0" role="status">Página atual: @pagination.CurrentPage</p>
</CodeExample>

@code {
    private readonly PaginationState<string> pagination = new(pageSize: 10);
    private PaginationSize size = PaginationSize.Medium;
    private ThemeColor? theme;
    private string ThemeAttribute => theme is { } value ? $" Theme=\"ThemeColor.{value}\"" : string.Empty;

    protected override void OnInitialized()
    {
        pagination.SetItems(Enumerable.Range(1, 300).Select(number => $"Registro {number}"));
        pagination.Changed += HandlePaginationChanged;
    }

    private void HandlePaginationChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => pagination.Changed -= HandlePaginationChanged;

    private string Code => $"<Pagination State=\"@pagination\" Size=\"PaginationSize.{size}\"{ThemeAttribute} />\n\n@code {{\n    private readonly PaginationState<string> pagination = new(pageSize: 10);\n\n    protected override void OnInitialized()\n    {{\n        pagination.SetItems(Enumerable.Range(1, 300).Select(number => $\"Registro {{number}}\"));\n    }}\n}}";
}
