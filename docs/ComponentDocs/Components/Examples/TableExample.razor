@inherits ExampleBase
@attribute [ComponentExample(typeof(Table<>))]

<div class="options-panel">
    <label class="form-check"><input type="checkbox" class="form-check-input" @bind="striped" /> Listras</label>
    <label class="form-check"><input type="checkbox" class="form-check-input" @bind="bordered" /> Bordas</label>
    <label class="form-check"><input type="checkbox" class="form-check-input" @bind="small" /> Compacta</label>
    <label class="form-check"><input type="checkbox" class="form-check-input" @bind="loading" /> Carregando</label>
    <label class="form-check"><input type="checkbox" class="form-check-input" @bind="empty" /> Vazia</label>
</div>
<CodeExample Code="@Code">
    <Table TItem="string" Items="@(empty ? Array.Empty<string>() : names.Skip((currentPage - 1) * 3).Take(3))"
           Caption="Pessoas" ColumnCount="1" Striped="@striped" Bordered="@bordered" Small="@small" Hover IsLoading="@loading">
        <HeaderContent><tr><th scope="col">Nome</th></tr></HeaderContent>
        <RowTemplate Context="name"><td>@name</td></RowTemplate>
    </Table>
    <Pagination PageCount="@(empty ? 0 : 3)" @bind-CurrentPage="currentPage" Disabled="@loading" Label="Páginas de pessoas" />
</CodeExample>

@code {
    private string[] names = ["Ana", "Bruno", "Carla", "Daniel", "Elisa", "Felipe", "Gabriela"];
    private int currentPage = 1;
    private bool striped = true, bordered, small, loading, empty;
    private string Code => $"<Table TItem=\"string\" Items=\"@(empty ? Array.Empty<string>() : names.Skip((currentPage - 1) * 3).Take(3))\"\n       Caption=\"Pessoas\" ColumnCount=\"1\" Striped=\"{Bool(striped)}\" Bordered=\"{Bool(bordered)}\"\n       Small=\"{Bool(small)}\" Hover IsLoading=\"@loading\">\n    <HeaderContent><tr><th scope=\"col\">Nome</th></tr></HeaderContent>\n    <RowTemplate Context=\"name\"><td>@name</td></RowTemplate>\n</Table>\n<Pagination PageCount=\"@(empty ? 0 : 3)\" @bind-CurrentPage=\"currentPage\" Disabled=\"@loading\" Label=\"Páginas de pessoas\" />\n\n@code {{\n    private string[] names = [\"Ana\", \"Bruno\", \"Carla\", \"Daniel\", \"Elisa\", \"Felipe\", \"Gabriela\"];\n    private int currentPage = 1;\n    private bool loading = {Bool(loading)}, empty = {Bool(empty)};\n}}";
}
