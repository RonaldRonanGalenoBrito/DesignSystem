@inherits ExampleBase
@attribute [ComponentExample(typeof(Alert))]

<div class="options-panel">
<label>Tema<select class="form-control form-control-sm mt-1" @bind="theme">
    <option value="">Padrão</option>
    @foreach (var value in Enum.GetValues<ThemeColor>()) { <option value="@value">@value</option> }
</select></label>
<label class="d-flex align-items-center gap-2"><input class="check" type="checkbox" @bind="floating" @bind:after="ShowAlert" /> Flutuante</label>
@if (floating)
{
    <label>Posição<select class="form-control form-control-sm mt-1" @bind="position">@foreach (var value in Enum.GetValues<AlertPosition>()) { <option value="@value">@GetPositionName(value)</option> }</select></label>
}
<button class="btn btn-sm btn-outline theme-secondary" type="button" @onclick="() => visible = true">Reabrir alerta</button>
</div>
@if (floating)
{
    @AlertPreview
}
<CodeExample Code="@Code">
@if (!floating)
{
    @AlertPreview
}
else if (visible)
{
    <p class="fg-2 small mb-0" role="status">O alerta está flutuando na janela: @GetPositionName(position). Use o seletor de posição para movê-lo.</p>
}
@if (!visible) { <p class="fg-2 small mb-0">Alerta fechado. Use “Reabrir alerta” para exibir novamente.</p> }
</CodeExample>

@code {
    private ThemeColor? theme;
    private bool visible = true;
    private bool floating;
    private AlertPosition position = AlertPosition.TopRight;
    private void ShowAlert() => visible = true;
    private RenderFragment AlertPreview => @<Alert Theme="@theme" Dismissible Floating="@floating" Position="@position" @bind-Visible="visible">Alterações salvas.</Alert>;
    private string ThemeAttribute => theme is { } value ? $" Theme=\"ThemeColor.{value}\"" : string.Empty;
    private string FloatingAttributes => floating
        ? $" Floating Position=\"AlertPosition.{position}\""
        : string.Empty;
    private string Code => $"<Alert{ThemeAttribute} Dismissible{FloatingAttributes} @bind-Visible=\"visible\">Alterações salvas.</Alert>\n\n@code {{\n    private bool visible = true;\n}}";

    private static string GetPositionName(AlertPosition value) => value switch
    {
        AlertPosition.TopRight => "Superior direita",
        AlertPosition.TopCenter => "Superior centro",
        AlertPosition.TopLeft => "Superior esquerda",
        AlertPosition.BottomRight => "Inferior direita",
        AlertPosition.BottomLeft => "Inferior esquerda",
        _ => value.ToString()
    };
}
