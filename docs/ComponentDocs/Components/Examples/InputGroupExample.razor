@inherits ExampleBase
@attribute [ComponentExample(typeof(InputGroup))]

<div class="options-panel">
    <label>
        Tamanho
        <select class="form-control form-control-sm mt-1" @bind="size">
            @foreach (var value in Enum.GetValues<ButtonSize>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
</div>

<CodeExample Code="@Code">
    <InputGroup Size="@size">
        <span class="input-group-text">R$</span>
        <input class="form-control" @bind="value" inputmode="decimal" aria-label="Valor" />
        <Button Theme="ThemeColor.Primary" Appearance="ButtonStyle.Outline">Calcular</Button>
    </InputGroup>
    <p class="small fg-2 mb-0">Valor informado: @value</p>
</CodeExample>

@code {
    private ButtonSize size = ButtonSize.Medium;
    private string value = "0,00";

    private string Code => $"<InputGroup Size=\"ButtonSize.{size}\">\n    <span class=\"input-group-text\">R$</span>\n    <input class=\"form-control\" />\n    <Button Theme=\"ThemeColor.Primary\" Appearance=\"ButtonStyle.Outline\">Calcular</Button>\n</InputGroup>";
}
