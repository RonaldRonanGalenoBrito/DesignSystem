@inherits ExampleBase
@attribute [ComponentExample(typeof(Badge))]

<div class="options-panel">
<label>Tema<select class="form-control form-control-sm mt-1" @bind="theme">
    <option value="">Padrão</option>
    @foreach (var value in Enum.GetValues<ThemeColor>()) { <option value="@value">@value</option> }
</select></label>
<label>Estilo<select class="form-control form-control-sm mt-1" @bind="appearance">
    @foreach (var value in Enum.GetValues<BadgeStyle>()) { <option value="@value">@value</option> }
</select></label>
<label class="d-flex align-items-center gap-2"><input class="check" type="checkbox" @bind="pill" /> Pill</label>
</div>
<CodeExample Code="@Code">
    <Badge Theme="@theme" Appearance="@appearance" Pill="@pill">Ativo</Badge>
</CodeExample>

@code {
    private ThemeColor? theme;
    private BadgeStyle appearance;
    private bool pill = true;
    private string ThemeAttribute => theme is { } value ? $" Theme=\"ThemeColor.{value}\"" : string.Empty;
    private string AppearanceAttribute => appearance == BadgeStyle.Solid ? string.Empty : $" Appearance=\"BadgeStyle.{appearance}\"";
    private string Code => $"<Badge{ThemeAttribute}{AppearanceAttribute} Pill=\"{Bool(pill)}\">Ativo</Badge>";
}

