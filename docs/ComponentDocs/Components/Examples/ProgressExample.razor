@inherits ExampleBase
@attribute [ComponentExample(typeof(Progress))]

<div class="options-panel">
<label>Tema<select class="form-control form-control-sm mt-1" @bind="theme">
    <option value="">Padrão</option>
    @foreach (var value in Enum.GetValues<ThemeColor>()) { <option value="@value">@value</option> }
</select></label>
<label>Valor: @progress<input class="form-range d-block mt-1" type="range" min="0" max="100" @bind="progress" @bind:event="oninput" /></label>
<label class="d-flex align-items-center gap-2"><input class="check" type="checkbox" @bind="animated" /> Animado</label>
</div>
<CodeExample Code="@Code">
<Progress Value="@progress" Max="100" Theme="@theme" Label="Envio dos arquivos" ShowLabel Striped Animated="@animated" />
</CodeExample>

@code {
    private ThemeColor? theme;
    private int progress = 65;
    private bool animated;
    private string ThemeAttribute => theme is { } value ? $" Theme=\"ThemeColor.{value}\"" : string.Empty;
    private string Code => $"<Progress Value=\"{progress}\" Max=\"100\"{ThemeAttribute}\n        Label=\"Envio dos arquivos\" ShowLabel Striped Animated=\"{Bool(animated)}\" />";
}

