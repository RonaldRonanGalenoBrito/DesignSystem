@inherits ExampleBase
@attribute [ComponentExample(typeof(Button))]

<div class="options-panel">
    <label>Tema
        <select class="form-control form-control-sm mt-1" @bind="theme">
            <option value="">Padrão</option>
            @foreach (var value in Enum.GetValues<ThemeColor>()) { <option value="@value">@value</option> }
        </select>
    </label>
    <div>
        <span class="d-block form-label">Estilo</span>
        <div class="btn-group" role="group" aria-label="Estilo do botão">
            @foreach (var value in Enum.GetValues<ButtonStyle>())
            {
                <button type="button" class="btn btn-sm theme-secondary @(appearance == value ? "btn-solid" : "btn-outline")"
                        aria-pressed="@(appearance == value ? "true" : "false")" @onclick="() => appearance = value">@value</button>
            }
        </div>
    </div>
    <label>Tamanho
        <select class="form-control form-control-sm mt-1" @bind="buttonSize">
            @foreach (var value in Enum.GetValues<ButtonSize>()) { <option value="@value">@value</option> }
        </select>
    </label>
    <div>
        <span class="d-block form-label">Arredondamento</span>
        <div class="btn-group" role="group" aria-label="Arredondamento do botão">
            @foreach (var value in Enum.GetValues<ButtonRounded>())
            {
                <button type="button" class="btn btn-sm theme-secondary @(rounded == value ? "btn-solid" : "btn-outline")"
                        aria-pressed="@(rounded == value ? "true" : "false")" @onclick="() => rounded = value">@value</button>
            }
        </div>
    </div>
    <label class="d-flex align-items-center gap-2"><input class="check" type="checkbox" @bind="loading" /> Carregando</label>
    <label class="d-flex align-items-center gap-2"><input class="check" type="checkbox" @bind="disabled" /> Desabilitado</label>
</div>
<CodeExample Code="@Code">
    <Button Theme="@theme" Appearance="@appearance" Size="@buttonSize" Rounded="@rounded"
            Icon="check-lg" IsLoading="@loading" Disabled="@disabled" OnClick="() => clicks++">Salvar alterações</Button>
    <span class="small fg-2 ms-4" role="status">Cliques: @clicks</span>
</CodeExample>

@code {
    private ThemeColor? theme;
    private ButtonStyle appearance = ButtonStyle.Styled;
    private ButtonSize buttonSize = ButtonSize.Medium;
    private ButtonRounded rounded;
    private bool loading, disabled;
    private int clicks;
    private string ThemeAttribute => theme is { } value ? $" Theme=\"ThemeColor.{value}\"" : string.Empty;
    private string Code => $"<Button{ThemeAttribute} Appearance=\"ButtonStyle.{appearance}\"\n        Size=\"ButtonSize.{buttonSize}\" Rounded=\"ButtonRounded.{rounded}\"\n        Icon=\"check-lg\" IsLoading=\"{Bool(loading)}\" Disabled=\"{Bool(disabled)}\"\n        OnClick=\"() => clicks++\">Salvar alterações</Button>\n\n@code {{\n    private int clicks;\n}}";
}