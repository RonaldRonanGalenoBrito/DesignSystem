@inherits ExampleBase
@attribute [ComponentExample(typeof(Spinner))]

<div class="options-panel">
<label>Tema<select class="form-control form-control-sm mt-1" @bind="theme">
    <option value="">Padrão</option>
    @foreach (var value in Enum.GetValues<ThemeColor>()) { <option value="@value">@value</option> }
</select></label>
<label class="d-flex align-items-center gap-2"><input class="check" type="checkbox" @bind="small" /> Pequeno</label>
<label class="d-flex align-items-center gap-2"><input class="check" type="checkbox" @bind="grow" /> Grow</label>
</div>
<CodeExample Code="@Code">
<Spinner Theme="@theme" Small="@small" Grow="@grow" Label="Carregando pedidos..." />
</CodeExample>

@code {
    private ThemeColor? theme;
    private bool small, grow;
    private string ThemeAttribute => theme is { } value ? $" Theme=\"ThemeColor.{value}\"" : string.Empty;
    private string Code => $"<Spinner{ThemeAttribute} Small=\"{Bool(small)}\" Grow=\"{Bool(grow)}\"\n         Label=\"Carregando pedidos...\" />";
}

