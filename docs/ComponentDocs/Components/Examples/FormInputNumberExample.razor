@inherits ExampleBase
@attribute [ComponentExample(typeof(FormInputNumber<>))]

<CodeExample Code="@Code">
<FormInputNumber TValue="decimal?" Label="Valor" @bind-Value="amount" min="0" step="0.01" />
<p class="small text-body-secondary mb-0">Valor: @(amount?.ToString() ?? "null")</p>
</CodeExample>

@code {
    private decimal? amount;
    private string Code => Entry.Code;
}

