@inherits ExampleBase
@attribute [ComponentExample(typeof(FormInputText))]

<CodeExample Code="@Code">
<FormInputText Label="Pesquisar" @bind-Value="name" HelpText="Informe um termo para pesquisar.">
    <PrefixContent><InputGroupText><Icon Name="search" /></InputGroupText></PrefixContent>
    <SuffixContent><Button Variant="ButtonVariant.OutlinePrimary">Buscar</Button></SuffixContent>
</FormInputText>
<p class="small text-body-secondary mb-0">Valor: @name</p>
</CodeExample>

@code {
    private string name = "";
    private string Code => Entry.Code;
}
