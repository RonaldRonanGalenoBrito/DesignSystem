@inherits ThemedComponentBase
@attribute [ComponentDoc(
    Slug = "icon",
    Name = "Icon",
    Group = "Conteúdo",
    Description = "Ícones vetoriais da fonte Bootstrap Icons.",
    Code = "<Icon Name=\"check-circle\" SizeClass=\"fs-2xl\" Theme=\"ThemeColor.Success\" Label=\"Concluído\" />",
    Guidance = "Informe Name sem o prefixo bi-. Theme define a cor usando os utilitários fg-* do Bootstrap; sem Theme, o ícone herda a cor do conteúdo. Sem Label, o ícone é decorativo e fica oculto de leitores de tela. A fonte Bootstrap Icons deve estar carregada."
)]

<i @attributes="AdditionalAttributes" class="@ThemedClasses(AdditionalAttributes, "bi", $"bi-{Name}", SizeClass, ThemeForegroundClass, ClassExtra)" style="@(Style ?? ComponentAttributes.Get(AdditionalAttributes, "style"))" role="@(string.IsNullOrWhiteSpace(Label) ? null : "img")" aria-label="@Label" aria-hidden="@(string.IsNullOrWhiteSpace(Label) ? "true" : null)"></i>

@code {
    [ParameterDoc("Descrição acessível do ícone. Sem Label, o ícone é decorativo.")]
    [Parameter] public string? Label { get; set; }
    /// <summary>
    /// Nome do ícone do Bootstrap (ex: "check-lg", "trash", "search", "person").
    /// </summary>
    [ParameterDoc("Nome do Bootstrap Icon.")]
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// Classe de tamanho do Bootstrap para tipografia (ex: "fs-4xl", "fs-3xl", "fs-lg").
    /// </summary>
    [ParameterDoc("Utilitário de tamanho, como fs-2xl.")]
    [Parameter]
    public string? SizeClass { get; set; }

    /// <summary>
    /// Classes CSS adicionais.
    /// </summary>
    [ParameterDoc("Classes CSS adicionais. Nos campos, estiliza o contêiner.")]
    [Parameter]
    public string? ClassExtra { get; set; }

    /// <summary>
    /// Estilos inline adicionais.
    /// </summary>
    [ParameterDoc("Estilos CSS inline do ícone.")]
    [Parameter]
    public string? Style { get; set; }

    /// <summary>
    /// Captura outros atributos HTML passados ao componente.
    /// </summary>
    [ParameterDoc("Atributos HTML adicionais; class é combinada às classes do componente.")]
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}


