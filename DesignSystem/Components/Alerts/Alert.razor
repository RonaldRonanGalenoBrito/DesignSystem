@inherits ThemedComponentBase
@attribute [ComponentDoc(
    Slug = "alert",
    Name = "Alert",
    Group = "Feedback",
    Description = "Mensagens contextuais de sucesso, informação, aviso e erro.",
    Code = "<Alert Theme=\"ThemeColor.Success\" Dismissible @bind-Visible=\"visible\">Alterações salvas.</Alert>\n\n@code {\n    private bool visible = true;\n}",
    Guidance = "Use @bind-Visible para fechar e reabrir a mesma instância. Defina Floating e Position para exibir o alerta sobre o conteúdo. DismissLabel personaliza o texto acessível do botão de fechar."
)]

@if (isVisible)
{
    <div @attributes="AdditionalAttributes" class="@GetCssClasses()" role="alert">
            @if (ShowIcon)
            {
                <Icon Name="@GetDefaultIcon()" ClassExtra="me-2 fs-lg" />
            }
            <div class="flex-grow-1">
                @ChildContent
            </div>
            @if (Dismissible)
            {
                <button type="button" class="btn-close" aria-label="@DismissLabel" @onclick="CloseAlert"></button>
            }
    </div>
}

@code {
    [ParameterDoc("Conteúdo Razor interno.")]
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [ParameterDoc("Nome acessível do botão de fechar.")]
    [Parameter] public string DismissLabel { get; set; } = "Fechar";
    [ParameterDoc("Exibe o botão de fechar.")]
    [Parameter] public bool Dismissible { get; set; }
    [ParameterDoc("Visibilidade do alerta; aceita @bind-Visible.")]
    [Parameter] public bool Visible { get; set; } = true;
    [ParameterDoc("Notifica mudança de visibilidade.")]
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [ParameterDoc("Exibe o ícone contextual do alerta.")]
    [Parameter] public bool ShowIcon { get; set; } = true;
    [ParameterDoc("Exibe o alerta sobre o conteúdo, fixado na tela.")]
    [Parameter] public bool Floating { get; set; }
    [ParameterDoc("Posição do alerta quando Floating estiver ativo.")]
    [Parameter] public AlertPosition Position { get; set; } = AlertPosition.TopRight;
    [ParameterDoc("Substitui o ícone padrão do alerta.")]
    [Parameter] public string? CustomIcon { get; set; }
    [ParameterDoc("Classes CSS adicionais. Nos campos, estiliza o contêiner.")]
    [Parameter] public string? ClassExtra { get; set; }
    [ParameterDoc("Notifica o fechamento do alerta.")]
    [Parameter] public EventCallback OnDismissed { get; set; }

    [ParameterDoc("Atributos HTML adicionais; class é combinada às classes do componente.")]

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool isVisible = true;
    private bool? previousVisible;

    protected override void OnParametersSet()
    {
        if (previousVisible != Visible) isVisible = Visible;
        previousVisible = Visible;
    }

    private async Task CloseAlert()
    {
        if (!isVisible) return;
        isVisible = false;
        await VisibleChanged.InvokeAsync(false);
        if (OnDismissed.HasDelegate)
        {
            await OnDismissed.InvokeAsync();
        }
    }

    private string GetCssClasses()
    {
        var classes = new List<string>
        {
            "alert",
            $"theme-{ResolveTheme(ThemeColor.Info)}"
        };


        if (Floating)
        {
            classes.Add("alert-floating position-fixed m-4");
            classes.Add(PositionClasses(Position));
        }
        if (!string.IsNullOrWhiteSpace(ClassExtra)) classes.Add(ClassExtra);

        return ComponentAttributes.Classes(AdditionalAttributes, classes.ToArray());
    }

    private static string PositionClasses(AlertPosition position) => position switch
    {
        AlertPosition.TopCenter => "top-0 start-50 translate-middle-x mx-0",
        AlertPosition.TopLeft => "top-0 start-0",
        AlertPosition.BottomRight => "bottom-0 end-0",
        AlertPosition.BottomLeft => "bottom-0 start-0",
        _ => "top-0 end-0"
    };

    private string GetDefaultIcon()
    {
        if (!string.IsNullOrEmpty(CustomIcon)) return CustomIcon;

        return ResolveTheme(ThemeColor.Info) switch
        {
            "success" => "check-circle-fill",
            "danger" => "exclamation-octagon-fill",
            "warning" => "exclamation-triangle-fill",
            "info" => "info-circle-fill",
            _ => "bell-fill"
        };
    }
}

