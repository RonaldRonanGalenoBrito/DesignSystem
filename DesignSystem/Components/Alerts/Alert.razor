@attribute [ComponentDoc(
    Slug = "alert",
    Name = "Alert",
    Group = "Feedback",
    Description = "Mensagens contextuais de sucesso, informação, aviso e erro.",
    Code = "<Alert Variant=\"AlertVariant.Success\" Dismissible @bind-Visible=\"visible\">Alterações salvas.</Alert>\n\n@code {\n    private bool visible = true;\n}",
    Guidance = "Use @bind-Visible para fechar e reabrir a mesma instância. DismissLabel personaliza o texto acessível do botão de fechar."
)]

@if (isVisible)
{
    <div @attributes="AdditionalAttributes" class="@GetCssClasses()" role="alert">
        <div class="d-flex align-items-center">
            @if (ShowIcon)
            {
                <Icon Name="@GetDefaultIcon()" ClassExtra="me-2 fs-5" />
            }
            <div class="flex-grow-1">
                @ChildContent
            </div>
            @if (Dismissible)
            {
                <button type="button" class="btn-close" aria-label="@DismissLabel" @onclick="CloseAlert"></button>
            }
        </div>
    </div>
}

@code {
    [ParameterDoc("Conteúdo Razor interno.")]
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [ParameterDoc("Variante de cor ou apresentação.")]
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Info;
    [ParameterDoc("Nome acessível do botão de fechar.")]
    [Parameter] public string DismissLabel { get; set; } = "Fechar";
    [ParameterDoc("Exibe o botão de fechar.")]
    [Parameter] public bool Dismissible { get; set; }
    [ParameterDoc("Visibilidade do alerta; aceita @bind-Visible.")]
    [Parameter] public bool Visible { get; set; } = true;
    [ParameterDoc("Notifica mudança de visibilidade.")]
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [ParameterDoc("Exibe o ícone contextual do alerta.")]
    [Parameter] public bool ShowIcon { get; set; } = true;
    [ParameterDoc("Substitui o ícone padrão do alerta.")]
    [Parameter] public string? CustomIcon { get; set; }
    [ParameterDoc("Classes CSS adicionais. Nos campos, estiliza o contêiner.")]
    [Parameter] public string? ClassExtra { get; set; }
    [ParameterDoc("Notifica o fechamento do alerta.")]
    [Parameter] public EventCallback OnDismissed { get; set; }

    [ParameterDoc("Atributos HTML adicionais; class é combinada às classes do componente.")]

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool isVisible = true;
    private bool? previousVisible;

    protected override void OnParametersSet()
    {
        if (previousVisible != Visible) isVisible = Visible;
        previousVisible = Visible;
    }

    private async Task CloseAlert()
    {
        if (!isVisible) return;
        isVisible = false;
        await VisibleChanged.InvokeAsync(false);
        if (OnDismissed.HasDelegate)
        {
            await OnDismissed.InvokeAsync();
        }
    }

    private string GetCssClasses()
    {
        var classes = new List<string>
        {
            "alert",
            $"alert-{Variant.ToString().ToLowerInvariant()}"
        };

        if (Dismissible) classes.Add("alert-dismissible fade show");
        if (!string.IsNullOrWhiteSpace(ClassExtra)) classes.Add(ClassExtra);

        return ComponentAttributes.Classes(AdditionalAttributes, classes.ToArray());
    }

    private string GetDefaultIcon()
    {
        if (!string.IsNullOrEmpty(CustomIcon)) return CustomIcon;

        return Variant switch
        {
            AlertVariant.Success => "check-circle-fill",
            AlertVariant.Danger => "exclamation-octagon-fill",
            AlertVariant.Warning => "exclamation-triangle-fill",
            AlertVariant.Info => "info-circle-fill",
            _ => "bell-fill"
        };
    }
}

