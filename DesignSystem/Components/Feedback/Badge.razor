@inherits ThemedComponentBase
@attribute [ComponentDoc(
    Slug = "badge",
    Name = "Badge",
    Group = "Feedback",
    Description = "Pequenos rótulos para status, categorias e contadores.",
    Code = "<Badge Theme=\"ThemeColor.Success\" Appearance=\"BadgeStyle.Subtle\" Pill>Ativo</Badge>",
    Guidance = "Appearance aceita Solid, Subtle ou Outline e usa as classes nativas do Bootstrap 6. Pill usa rounded-pill para o formato de cápsula. Sem Pill, rounded-4 mantém cantos levemente arredondados. O tamanho acompanha a fonte do elemento pai. Inclua texto que explique o significado da cor."
)]

<span @attributes="AdditionalAttributes"
      class="@ComponentAttributes.Classes(AdditionalAttributes, "badge", $"theme-{ResolveTheme(ThemeColor.Secondary)}", Appearance switch { BadgeStyle.Subtle => "badge-subtle", BadgeStyle.Outline => "badge-outline", _ => null }, Pill ? "rounded-pill" : "rounded-4", ClassExtra)">
    @ChildContent
</span>

@code {
    [ParameterDoc("Conteúdo Razor interno.")]
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [ParameterDoc("Apresentação visual sólida, suave (Subtle) ou contornada (Outline).")]
    [Parameter] public BadgeStyle Appearance { get; set; } = BadgeStyle.Solid;
    [ParameterDoc("Usa formato de cápsula com rounded-pill. False usa rounded-4 para cantos levemente arredondados.")]
    [Parameter] public bool Pill { get; set; }
    [ParameterDoc("Classes CSS adicionais. Nos campos, estiliza o contêiner.")]
    [Parameter] public string? ClassExtra { get; set; }
    [ParameterDoc("Atributos HTML adicionais; class é combinada às classes do componente.")]
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

