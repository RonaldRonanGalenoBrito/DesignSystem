@attribute [ComponentDoc(
    Slug = "spinner",
    Name = "Spinner",
    Group = "Feedback",
    Description = "Indicadores de carregamento com rótulo visível e duas animações.",
    Code = "<Spinner Variant=\"ColorVariant.Primary\" Label=\"Carregando pedidos...\" />",
    Guidance = "Use Label para explicar o que está sendo carregado; ele aparece ao lado do indicador. ShowLabel=false mantém o texto apenas para leitores de tela. Small reduz o tamanho; Grow troca o círculo pela animação de expansão."
)]

<span @attributes="AdditionalAttributes" role="status"
      class="@ComponentAttributes.Classes(AdditionalAttributes, "d-inline-flex align-items-center gap-2", $"text-{Variant.ToString().ToLowerInvariant()}", ClassExtra)">
    <span class="@ComponentAttributes.Classes(null, SpinnerClass, Small ? $"{SpinnerClass}-sm" : null)" aria-hidden="true"></span>
    @if (ShowLabel)
    {
        <span>@Label</span>
    }
    else
    {
        <span class="visually-hidden">@Label</span>
    }
</span>

@code {
    [ParameterDoc("Variante de cor ou apresentação.")]
    [Parameter] public ColorVariant Variant { get; set; } = ColorVariant.Primary;
    [ParameterDoc("Usa o spinner pequeno.")]
    [Parameter] public bool Small { get; set; }
    [ParameterDoc("Usa a animação spinner-grow.")]
    [Parameter] public bool Grow { get; set; }
    [ParameterDoc("Texto mostrado ao lado do indicador e anunciado aos leitores de tela.")]
    [Parameter] public string Label { get; set; } = "Carregando...";
    [ParameterDoc("Exibe o rótulo ao lado do indicador. False o mantém apenas para leitores de tela.")]
    [Parameter] public bool ShowLabel { get; set; } = true;
    [ParameterDoc("Classes CSS adicionais. Nos campos, estiliza o contêiner.")]
    [Parameter] public string? ClassExtra { get; set; }
    [ParameterDoc("Atributos HTML adicionais; class é combinada às classes do componente.")]
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    private string SpinnerClass => Grow ? "spinner-grow" : "spinner-border";
}


