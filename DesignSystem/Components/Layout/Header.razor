@attribute [ComponentDoc(
    Slug = "header",
    Name = "Header",
    Group = "Layout",
    Description = "Cabeçalho com marca, ações e botão de navegação mobile.",
    Code = "<Header Title=\"Meu sistema\">\n    <Actions><Button Variant=\"ButtonVariant.OutlinePrimary\">Meu perfil</Button></Actions>\n</Header>",
    Guidance = "Dentro de AppShell, o botão mobile é coordenado automaticamente. Fora dele, use ShowMenuToggle, SidebarId, MenuOpen e OnMenuToggle para controlar um menu externo."
)]

<header @attributes="AdditionalAttributes" class="@ComponentAttributes.Classes(AdditionalAttributes, "navbar bg-body border-bottom px-3 py-2", ClassExtra)">
    <div class="d-flex align-items-center gap-3 flex-wrap w-100">
        @if (Layout is not null || ShowMenuToggle)
        {
            <button type="button" class="btn btn-outline-secondary d-lg-none"
                    aria-label="@MenuLabel" aria-controls="@(Layout?.SidebarId ?? SidebarId)"
                    aria-expanded="@((Layout?.MenuOpen ?? MenuOpen) ? "true" : "false")" @onclick="Toggle">
                <Icon Name="list" SizeClass="fs-5" />
            </button>
        }
        <div class="me-auto">
            @if (BrandContent is not null)
            {
                @BrandContent
            }
            else
            {
                <span class="navbar-brand mb-0 text-wrap">@Title</span>
            }
        </div>
        @if (ChildContent is not null)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap">@ChildContent</div>
        }
        @if (Actions is not null)
        {
            <div class="d-flex align-items-center gap-2 flex-wrap">@Actions</div>
        }
    </div>
</header>

@code {
    [CascadingParameter] public LayoutContext? Layout { get; set; }
    [ParameterDoc("Título exibido.")]
    [Parameter] public string? Title { get; set; }
    [ParameterDoc("Marca personalizada; substitui Title.")]
    [Parameter] public RenderFragment? BrandContent { get; set; }
    [ParameterDoc("Conteúdo Razor interno.")]
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [ParameterDoc("Conteúdo de ações do header.")]
    [Parameter] public RenderFragment? Actions { get; set; }
    [ParameterDoc("Nome acessível do botão do menu.")]
    [Parameter] public string MenuLabel { get; set; } = "Alternar menu";
    [ParameterDoc("Habilita o botão mobile fora de AppShell.")]
    [Parameter] public bool ShowMenuToggle { get; set; }
    [ParameterDoc("ID do menu externo controlado pelo header.")]
    [Parameter] public string? SidebarId { get; set; }
    [ParameterDoc("Estado do menu externo.")]
    [Parameter] public bool MenuOpen { get; set; }
    [ParameterDoc("Solicita alternância do menu externo.")]
    [Parameter] public EventCallback OnMenuToggle { get; set; }
    [ParameterDoc("Classes CSS adicionais. Nos campos, estiliza o contêiner.")]
    [Parameter] public string? ClassExtra { get; set; }
    [ParameterDoc("Atributos HTML adicionais; class é combinada às classes do componente.")]
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    private Task Toggle() => Layout?.ToggleMenu() ?? OnMenuToggle.InvokeAsync();
}

