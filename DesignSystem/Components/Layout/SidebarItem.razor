@using Microsoft.AspNetCore.Components.Routing
@attribute [ComponentDoc(
    Slug = "sidebar-item",
    Name = "SidebarItem",
    Group = "Layout",
    Description = "Links de navegação com ícone, estado ativo e conteúdo adicional.",
    Code = "<SidebarItem Href=\"componentes/sidebar-item\" Text=\"Componentes\" Icon=\"grid\" Match=\"NavLinkMatch.All\">\n    <Badge ClassExtra=\"ms-auto\">18</Badge>\n</SidebarItem>",
    Guidance = "As cores hexadecimais sobrescrevem a paleta herdada do Sidebar apenas neste item, incluindo hover e ativo. Usa NavLink para acompanhar a rota ativa. All corresponde à página; Prefix inclui subrotas. Disabled remove o href e os eventos, mas não substitui a autorização das rotas."
)]

<span class="sidebar-item">
@if (Disabled)
{
    <span @attributes="DisabledAttributes" style="@ColorStyle" class="@CssClass" role="link" aria-disabled="true">
        @Content
    </span>
}
else
{
    <NavLink @attributes="AdditionalAttributes" style="@ColorStyle" href="@Href" class="@CssClass" Match="@Match"
             ActiveClass="active" @onclick="Navigate">
        @Content
    </NavLink>
}

</span>

@code {
    [Parameter, ParameterDoc("Cor hexadecimal do fundo dos links. Null usa a cor herdada ou padrão.")]
    public string? BackgroundColor { get; set; }
    [Parameter, ParameterDoc("Cor hexadecimal do texto e ícones dos links. Null usa a cor herdada ou padrão.")]
    public string? TextColor { get; set; }
    [Parameter, ParameterDoc("Cor hexadecimal do fundo dos links em hover ou foco por teclado. Null usa a cor herdada ou padrão.")]
    public string? HoverBackgroundColor { get; set; }
    [Parameter, ParameterDoc("Cor hexadecimal do texto dos links em hover ou foco por teclado. Null usa a cor herdada ou padrão.")]
    public string? HoverTextColor { get; set; }
    [Parameter, ParameterDoc("Cor hexadecimal do fundo do link ativo. Null usa a cor herdada ou padrão.")]
    public string? ActiveBackgroundColor { get; set; }
    [Parameter, ParameterDoc("Cor hexadecimal do texto do link ativo. Null usa a cor herdada ou padrão.")]
    public string? ActiveTextColor { get; set; }
    private string ColorStyle => SidebarColors.Style(AdditionalAttributes,
        ("--sidebar-item-bg", BackgroundColor),
        ("--sidebar-item-color", TextColor),
        ("--sidebar-item-hover-bg", HoverBackgroundColor),
        ("--sidebar-item-hover-color", HoverTextColor),
        ("--sidebar-item-active-bg", ActiveBackgroundColor),
        ("--sidebar-item-active-color", ActiveTextColor));

    [CascadingParameter] public LayoutContext? Layout { get; set; }
    [ParameterDoc("Destino relativo ou absoluto do link.")]
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [ParameterDoc("Texto do link.")]
    [Parameter] public string? Text { get; set; }
    [ParameterDoc("Nome do Bootstrap Icon, sem o prefixo bi-.")]
    [Parameter] public string? Icon { get; set; }
    [ParameterDoc("Conteúdo Razor interno.")]
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [ParameterDoc("Desabilita interação.")]
    [Parameter] public bool Disabled { get; set; }
    [ParameterDoc("Regra de correspondência da rota ativa.")]
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    [ParameterDoc("Callback executado no clique habilitado.")]
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [ParameterDoc("Classes CSS adicionais. Nos campos, estiliza o contêiner.")]
    [Parameter] public string? ClassExtra { get; set; }
    [ParameterDoc("Atributos HTML adicionais; class é combinada às classes do componente.")]
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    private string CssClass => ComponentAttributes.Classes(AdditionalAttributes, "sidebar-link nav-link d-flex align-items-center gap-2", Disabled ? "disabled" : null, ClassExtra);
    private Dictionary<string, object>? DisabledAttributes => AdditionalAttributes?
        .Where(pair => !pair.Key.StartsWith("on", StringComparison.OrdinalIgnoreCase) &&
            !new[] { "href", "tabindex", "target" }.Contains(pair.Key, StringComparer.OrdinalIgnoreCase))
        .ToDictionary(pair => pair.Key, pair => pair.Value);
    private RenderFragment Content => @<text>
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <Icon Name="@Icon" />
        }
        <span>@Text</span>
        @ChildContent
    </text>;
    private async Task Navigate(MouseEventArgs args)
    {
        await OnClick.InvokeAsync(args);
        if (Layout is not null && args.Button == 0 && !args.CtrlKey && !args.MetaKey && !args.ShiftKey && !args.AltKey)
            await Layout.CloseMenu();
    }
}



