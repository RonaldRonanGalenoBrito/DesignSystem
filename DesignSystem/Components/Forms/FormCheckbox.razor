@inherits FormFieldBase<bool>
@attribute [ComponentDoc(
    Slug = "form-checkbox",
    Name = "FormCheckbox",
    Group = "Formulários",
    Description = "Campo booleano com caixa de seleção quadrada.",
    Code = "<FormCheckbox Label=\"Aceito os termos\" @bind-Value=\"accepted\" />\n\n@code {\n    private bool accepted;\n}",
    Guidance = "Use FormCheckbox para uma caixa de seleção e FormSwitch para um interruptor. Para exigir valor true no modelo, use uma regra específica: Required sozinho não rejeita false. Theme define a cor marcada; Size usa FormControlSize: Small, Medium ou Large."
)]

<div data-bs-theme="@DataBsTheme" class="@(UseMarginBottom ? "mb-4" : null) @ThemeClass @ClassExtra">
    <div class="d-flex align-items-center gap-2">
        <InputCheckbox @attributes="AdditionalAttributes" id="@Id" class="@ControlClass(CheckClass)"
                       Value="@Value" ValueChanged="ChangeValue" ValueExpression="@EffectiveExpression" DisplayName="@Label"
                       disabled="@Disabled" required="@Required"
                       aria-invalid="@Invalid" aria-describedby="@DescribedBy" />
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <label class="form-label mb-0" for="@Id">@Label</label>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <div id="@($"{Id}-help")" class="form-text">@HelpText</div>
    }
    @if (ValidationError is not null)
    {
        <div id="@($"{Id}-error")" class="invalid-feedback d-block">@ValidationError</div>
    }
</div>

@code {
    [ParameterDoc("Tamanho Bootstrap do controle: Small, Medium ou Large.")]
    [Parameter] public FormControlSize Size { get; set; } = FormControlSize.Medium;

    private string CheckClass => Size switch
    {
        FormControlSize.Small => "check check-sm",
        FormControlSize.Large => "check check-lg",
        _ => "check"
    };
}



