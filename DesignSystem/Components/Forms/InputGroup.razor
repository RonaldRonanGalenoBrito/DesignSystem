@inherits ThemedComponentBase
@attribute [ComponentDoc(
    Slug = "input-group",
    Name = "InputGroup",
    Group = "Formulários",
    Description = "Agrupa controles, textos e botões em uma única linha de formulário.",
    Code = "<InputGroup>\n    <span class=\"input-group-text\">R$</span>\n    <input class=\"form-control\" placeholder=\"0,00\" />\n    <Button Theme=\"ThemeColor.Primary\" Appearance=\"ButtonStyle.Outline\">Calcular</Button>\n</InputGroup>",
    Guidance = "Use a classe Bootstrap input-group-text em um span para exibir prefixos, moedas ou ícones. FormText aceita PrefixContent e SuffixContent para manter label e validação do campo."
)]

<div @attributes="AdditionalAttributes" class="@Classes">
    @ChildContent
</div>

@code {
    [ParameterDoc("Conteúdo do grupo, como um span com input-group-text, controles e Button.")]
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [ParameterDoc("Tamanho dos controles no grupo.")]
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;
    [ParameterDoc("Classes CSS adicionais aplicadas ao grupo.")]
    [Parameter] public string? ClassExtra { get; set; }
    [Parameter(CaptureUnmatchedValues = true), ParameterDoc("Atributos HTML adicionais; class é combinada às classes do componente.")]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string Classes => ThemedClasses(AdditionalAttributes,
        "input-group",
        Size == ButtonSize.Small ? "input-group-sm" : null,
        Size == ButtonSize.Large ? "input-group-lg" : null,
        ClassExtra);
}
